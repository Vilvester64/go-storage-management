# --- SERVER CONFIGURATION ---
PORT=8080
GIN_MODE=debug

# --- DATABASE CONFIGURATION (MySQL via Laragon) ---
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
